{
  "name": "kururu",
  "version": "0.1.0",
  "private": true,
  "description": "A GUI for the agents it runs — on the desktop and on your phone.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "dev": "node server/run.mjs --watch",
    "dev:web": "bun run --cwd web dev",
    "dev:desktop": "KURURU_DEV=1 bun run --cwd desktop start",
    "start": "bun run build:web && node server/run.mjs",
    "build": "bun run build:web && bun run build:server",
    "build:web": "bun run --cwd web build",
    "build:server": "node desktop/build.mjs",
    "icon": "node tools/icon.mjs",
    "host": "bun run build:server && node desktop/dist/ptyhostd.mjs",
    "status": "node server/status.mjs",
    "kill-ptyhosts": "node server/kill-hosts.mjs",
    "dist": "bun run build && electron-builder --projectDir desktop --mac",
    "dist:unsigned": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --projectDir desktop --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd web typecheck",
    "test": "bun test",
    "postinstall": "node desktop/brand.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
